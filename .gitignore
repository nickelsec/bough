# build output
/bough
/bough.exe
/dist/

# go
*.test
*.out

# intermediate output of assets/build.py. The results it produces,
# internal/server/fonts.css and internal/server/img, are committed because the
# binary embeds them and a clone has to build without running Python.
/assets/fonts/*.woff2
/assets/__pycache__/

# research scratch
/.firecrawl/

# editors
.idea/
.vscode/
*.swp
.DS_Store

# the demo recording. It is uploaded to a release rather than committed,
# because a full resolution video is megabytes that every clone would carry
# forever. docs/img/screenshot.png is the still that does get committed.
*.webm
*.mp4
